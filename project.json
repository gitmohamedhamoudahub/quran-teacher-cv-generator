{
  "name": "CV Form Generator",
  "description": "أداة إنشاء السيرة الذاتية الاحترافية لمحفظي القرآن الكريم ومعلمي التجويد أونلاين",
  "version": "1.0.0",
  "author": "محمد",
  "license": "MIT",
  "repository": "local",
  
  "project_info": {
    "target_users": "محفظو القرآن الكريم، معلمو التجويد، المعلمون أونلاين",
    "main_features": [
      "نموذج بيانات شامل بـ 5 أقسام",
      "حفظ البيانات محلياً (localStorage)",
      "توليد ملف Word (.docx) معبأ",
      "دعم كامل للعربية (RTL)",
      "واجهة responsive (موبايل + ديسكتوب)"
    ]
  },

  "tech_stack": {
    "frontend": {
      "language": "HTML5 + CSS3 + Vanilla JavaScript",
      "storage": "localStorage (browser)",
      "libraries": [
        "JSZip (create DOCX files)",
        "FileSaver (download files)"
      ]
    },
    "tools": {
      "editor": "Claude Code Desktop",
      "version_control": "Git",
      "testing": "Browser DevTools"
    }
  },

  "files_description": {
    "index.html": {
      "lines": "~130",
      "purpose": "Main form structure with 5 tabs",
      "key_sections": [
        "Header (title + subtitle)",
        "Tab navigation buttons",
        "5 tab contents (personal, professional, qualifications, experience, teaching)",
        "Action buttons (save, download, reset)"
      ]
    },
    "styles.css": {
      "lines": "~230",
      "purpose": "All styling and responsive design",
      "key_sections": [
        "Base styles (colors, typography, spacing)",
        "Layout (grid, flex, containers)",
        "Form elements styling",
        "Tab navigation styling",
        "Buttons styling",
        "Responsive breakpoints",
        "Utilities (status messages, notes)"
      ]
    },
    "app.js": {
      "lines": "~280",
      "purpose": "All JavaScript logic",
      "key_functions": [
        "loadData() - Load from localStorage",
        "saveData() - Save to localStorage",
        "resetForm() - Clear all data",
        "switchTab() - Tab navigation",
        "generateDocument() - Create Word file",
        "createWordXml() - Word document structure",
        "escapeXml() - Escape special characters"
      ]
    }
  },

  "local_setup": {
    "folder_location": "~/work/cv-form-generator",
    "required_files": [
      "index.html",
      "styles.css",
      "app.js"
    ],
    "optional_files": [
      "README.md",
      "TODO.md",
      "QUICK_START.md",
      "LOCAL_SETUP.md",
      "CHEATSHEET.md"
    ],
    "setup_steps": [
      "Create folder ~/work/cv-form-generator",
      "Copy required files",
      "Open in Claude Code: code .",
      "Install Live Server extension",
      "Right-click index.html → Open with Live Server",
      "Form opens in browser and works locally"
    ]
  },

  "development_workflow": {
    "step1": "Edit file in Claude Code",
    "step2": "Save (Ctrl+S)",
    "step3": "Browser auto-refreshes with Live Server",
    "step4": "Test in browser",
    "step5": "Check console (F12) for errors",
    "step6": "Commit changes (git commit)",
    "step7": "Pick next feature from TODO.md"
  },

  "data_structure": {
    "storage": "localStorage with key 'cvData'",
    "format": "JSON",
    "fields": {
      "personal": [
        "fullName",
        "jobTitle",
        "location",
        "yearsExp",
        "phone",
        "email",
        "languages"
      ],
      "professional": [
        "biography"
      ],
      "qualifications": [
        "academicQualification",
        "institution",
        "qualYear",
        "quranicIjaza",
        "additionalCertificates"
      ],
      "experience": [
        "positionName",
        "workPlace",
        "workFromYear",
        "workToYear",
        "jobResponsibilities",
        "numStudents",
        "targetAges"
      ],
      "teaching": [
        "platforms",
        "lessonDuration",
        "lessonsPerWeek",
        "teachingDays",
        "teachingMethod",
        "achievements"
      ]
    }
  },

  "features": {
    "current_mvp": [
      "✅ Multi-tab form with 25+ fields",
      "✅ Auto-save to browser storage",
      "✅ Auto-load on page reload",
      "✅ Generate Word document (.docx)",
      "✅ RTL Arabic support",
      "✅ Responsive mobile design",
      "✅ Form validation (required fields)",
      "✅ Status messages (success/error)"
    ],
    "planned_enhancements": [
      "🔲 Image upload (profile photo + signature)",
      "🔲 Better Word formatting (tables + styling)",
      "🔲 Multiple CV management",
      "🔲 Live preview pane",
      "🔲 PDF export option",
      "🔲 Database integration (Firebase/IndexedDB)",
      "🔲 Auto-save every 30 seconds",
      "🔲 Dark mode toggle",
      "🔲 Share via URL",
      "🔲 Form validation improvements"
    ]
  },

