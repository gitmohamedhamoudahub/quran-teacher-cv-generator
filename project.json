  "troubleshooting": {
    "word_not_generating": [
      "Check browser console (F12) for errors",
      "Verify all required fields are filled",
      "Try different browser",
      "Check internet connection (for CDN libraries)"
    ],
    "data_not_saving": [
      "Check localStorage in F12 → Application",
      "Try incognito mode (localStorage works there)",
      "Clear browser cache",
      "Check if localStorage is disabled"
    ],
    "arabic_text_issues": [
      "Verify UTF-8 encoding in index.html",
      "Check RTL direction attribute",
      "Test in different browser",
      "Check Word language settings"
    ],
    "styling_not_applied": [
      "Save CSS file (Ctrl+S)",
      "Hard refresh browser (Ctrl+Shift+R)",
      "Check browser DevTools for CSS errors",
      "Verify file name is styles.css"
    ]
